# Project Nemesis — Environment Variables
# Copy this file to .env and fill in values as you add API keys in later phases.

# ── Backend ──
NEMESIS_ENV=development         # development | production
LOG_LEVEL=INFO
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Phase 2: Google Maps 3D Tiles (for city plunge feature) ──
# GOOGLE_MAPS_API_KEY=your_key_here

# ── Phase 3: OSINT / News feeds ──
# GDELT_API_ENDPOINT=https://api.gdeltproject.org/api/v2/...
# RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://...

# ── CelesTrak (no key needed — public API) ──
CELESTRAK_GROUPS=visual,stations,gnss
TLE_REFRESH_INTERVAL_SECONDS=3600

# ── WebSocket ──
WS_TELEMETRY_INTERVAL_SECONDS=5
